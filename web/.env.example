# Cation frontend runs with zero required env vars on testnet.
# All contract addresses and Circle's USDC issuer are baked into lib/config.ts.
#
# Optional override (only if pointing at a different USDC issuer/network):
# NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
