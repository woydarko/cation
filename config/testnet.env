# Cation testnet config. Fill the two Blend-dependent addresses before `init`.
# Source this file (or export) before running scripts/*.sh.

NETWORK=testnet
ADMIN_KEY=cation-admin           # stellar keys identity used as admin/keeper

# ---- must be set before initialize ----------------------------------------
# Testnet USDC as a Soroban token (Stellar Asset Contract id).
#   derive from an asset: stellar contract id asset --asset USDC:<ISSUER> --network testnet
# Circle official testnet USDC. Users claim via https://faucet.circle.com/
# No internal mint. Blend pool must have this asset as reserve 3.
USDC_SAC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Blend testnet lending pool. Reserves [XLM, wETH, wBTC, USDC:GBBD...].
# Deployed via blend-utils with Circle USDC (CationCircle).
BLEND_POOL=CAVWW7H5OAG6KT5XZVAUJC5VQGUNWMQRLG5J64QU6C2GOBQFAWWXBL74

# ---- draw / lock params ----------------------------------------------------
DRAW_INTERVAL_LEDGERS=17280       # ~1 day at 5s ledgers (daily)
PENALTY_BPS=500                   # 5% early-exit penalty

# ---- filled by deploy ------------------------------------------------------
# Active app instance: DAILY draw interval (17280 ledgers ~24h). Circle USDC.
PRIZE_POOL_ID=CCH4D3UDFBESA7EXY7SPCZTM5CLJQGGOSO4B4XWBFSJCDUY5HRUSXKEB
# Earlier instance bound to official (issuer-gated) Blend USDC, read-path only:
# PRIZE_POOL_ID=CBIGYGDT7RHPJ2K437PRK555WYRALZDGTXZFAGD737GWNA4GYITS7OMQ
