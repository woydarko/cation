# Cation testnet config. Fill the two Blend-dependent addresses before `init`.
# Source this file (or export) before running scripts/*.sh.

NETWORK=testnet
ADMIN_KEY=cation-admin           # stellar keys identity used as admin/keeper

# ---- must be set before initialize ----------------------------------------
# Testnet USDC as a Soroban token (Stellar Asset Contract id).
#   derive from an asset: stellar contract id asset --asset USDC:<ISSUER> --network testnet
# Circle official testnet USDC. Users claim via https://faucet.circle.com/
# No internal mint. Our Blend pool has this asset as reserve index 0.
USDC_SAC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Our Blend lending pool (CationCircle), deployed via factory with Circle USDC
# as reserve index 0, backstop funded, status active (0). Supplier-only.
BLEND_POOL=CDCCWAQCFXSJOWTYQRI4NPBVGC3NQDR3626MLOEAWLHXUECCASSW5ZPX

# ---- draw / lock params ----------------------------------------------------
# Seconds between draws. The contract anchors to the next multiple of this from
# the unix epoch, so 86400 fires the draw daily at exactly 00:00 UTC (no drift).
DRAW_PERIOD_SECONDS=86400         # daily at 00:00 UTC
PENALTY_BPS=500                   # 5% early-exit penalty

# ---- filled by deploy ------------------------------------------------------
# Active app instance: DAILY draw interval (17280 ledgers ~24h). Circle USDC,
# bound to the active CationCircle Blend pool above. Deposit verified on-chain.
PRIZE_POOL_ID=CA2R26QQEXNMQ6CXFINDKPKTEDUWV6E3OWSHPMEO62PSNOYR2QZ4QILW
# Prior instances (stale): CCH4D3UD... (Blend pool was Setup, #1206), CBIGYGDT...
