# Cation testnet config. Fill the two Blend-dependent addresses before `init`.
# Source this file (or export) before running scripts/*.sh.

NETWORK=testnet
ADMIN_KEY=cation-admin           # stellar keys identity used as admin/keeper

# ---- must be set before initialize ----------------------------------------
# Testnet USDC as a Soroban token (Stellar Asset Contract id).
#   derive from an asset: stellar contract id asset --asset USDC:<ISSUER> --network testnet
# Our OWN Blend stack (deployed via blend-utils, issuer = cation-admin) so we
# can MINT test USDC for onboarding/faucet. USDC is reserve index 3. See
# docs/TESTNET.md. (The official Blend testnet USDC is issuer-gated and cannot
# be distributed to users, so we run a controllable copy.)
USDC_SAC=CASWO3VWUS5LQNESTAOL2FJPPPCEV6BT27UVBED2JUYNSRV5QNEB2KKI

# Blend testnet lending pool (our deploy). Reserves [XLM, wETH, wBTC, USDC].
BLEND_POOL=CAYFESJVBO2OLTRYGYDS46MLDKONFYCRSE4HEJ3D75LCIDHF63RA22LY

# ---- draw / lock params ----------------------------------------------------
DRAW_INTERVAL_LEDGERS=17280       # ~1 day at 5s ledgers (daily)
PENALTY_BPS=500                   # 5% early-exit penalty

# ---- filled by deploy ------------------------------------------------------
# Active app instance: DAILY draw interval (17280 ledgers ~24h). This is the id
# the frontend points at and the keeper cron's POOL_ID secret should use.
PRIZE_POOL_ID=CBJ7YBMCCSBKO43XBHYGAPOTS5WTQP3JE46FNK3Q5ZRNXMBX73ND6AIX
# Earlier instance bound to official (issuer-gated) Blend USDC, read-path only:
# PRIZE_POOL_ID=CBIGYGDT7RHPJ2K437PRK555WYRALZDGTXZFAGD737GWNA4GYITS7OMQ
